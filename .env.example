# Copy to .env (gitignored). Read literally by `go run ./tools/release`
# (never `source` it: a CurseForge key contains "$"). The environment wins.
# Azure application (client) ID, approved for the Minecraft services API.
QUARTZ_MSA_CLIENT_ID=
# CurseForge API key (console.curseforge.com).
QUARTZ_CF_API_KEY=
# Discord application ID for Rich Presence (optional).
QUARTZ_DISCORD_CLIENT_ID=
